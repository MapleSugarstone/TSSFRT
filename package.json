{
  "name": "super-fighter-port",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript port of a block-based platform fighter, with rollback netplay.",
  "scripts": {
    "extract": "node tools/extract.mjs",
    "ref:dump": "tsx tools/ref-dump.ts",
    "transpile": "tsx tools/transpile/main.ts",
    "assets": "tsx tools/assets.ts",
    "site-images": "tsx tools/site-images.ts",
    "refmath": "esbuild src/engine/dmath.ts --bundle --format=iife --global-name=DMATH --outfile=reference/dmath.js",
    "dev": "vite",
    "characters": "vite --open /mod-maker.html",
    "characters:build": "tsx tools/characters/build.ts",
    "characters:export": "tsx tools/characters/export.ts",
    "build": "tsx tools/characters/build.ts && vite build",
    "preview": "vite preview",
    "worker:dev": "npm --prefix server run dev",
    "worker:deploy": "npm --prefix server run deploy",
    "typecheck": "tsc --noEmit",
    "test:parity": "tsx tools/parity-all.ts 4",
    "test:rollback": "tsx tools/rollback-test.ts tests/scenarios/tutorial-fuzz.json",
    "test:net": "tsx tools/netsim.ts 3 3000 120 40 0.1",
    "test:visual": "tsx tools/visual.ts tests/scenarios/to-main-menu.json 60,280,400,800",
    "test:math": "tsx tools/dmath-test.ts"
  },
  "devDependencies": {
    "@scratch/scratch-render": "15.1.1",
    "@scratch/scratch-svg-renderer": "15.1.1",
    "@scratch/scratch-vm": "15.1.1",
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "jszip": "3.10.1",
    "lucide": "1.58.0",
    "playwright-core": "^1.64.1",
    "ses": "2.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
