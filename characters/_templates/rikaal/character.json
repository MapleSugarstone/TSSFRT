  "text": {
    "lore": "As guardian of the Combo Gem, Rikaal was summoned by a disturbance in its sanctuary. To test the interlopers’ worth, the Super Fighter Tournament is initiated once more!",
    "mechanics": "Rikaal is a heavy grappler, clawing at foes and throwing them across the stage. Slow but extremely powerful, they make use of several unblockable grab attacks!",
    "combo": [
      {
        "name": "Vice Grip",
        "description": "Leap forward to grab your opponent and throw them in a chosen direction. You're invulnerable during the initial dash!"
      },
      {
        "name": "Primal Roar",
        "description": "Let out a deafening Shockwave, sending nearby opponents flying!"
      },
      {
        "name": "Absolution",
        "description": "Unleash the full power of the combo gem in a devastating beam of directable energy!"
      }
    ]
  },
