  "text": {
    "lore": "Deemed unworthy of holding the Sword of Light after trying to take the Combo Gem all for himself, this human lost himself to the \"Darc\", an evil force feeding on the spiteful and power-hungry.",
    "mechanics": "Darc uses slow, but heavy attacks and keeps enemies close, with no chance of escape!",
    "combo": [
      {
        "name": "Hungry Scarfling",
        "description": "Your Scarfling chomps at the opponent, pulling them in. Can also be used as a grappling hook if aimed in a specific direction!"
      },
      {
        "name": "Deadly Portal",
        "description": "Open up three portals behind the opponent, out of which deadly blades and spears appear."
      },
      {
        "name": "Darc Zone",
        "description": "Form a cage of evil energy around you, knocking opponents back to you if they try to escape."
      }
    ]
  },
