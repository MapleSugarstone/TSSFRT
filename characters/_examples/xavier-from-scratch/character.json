  "text": {
    "lore": "Xavier, rebuilt from a triangle, a circle and an orb in the mod maker. He has no template: every move is his own data, his gimmick script does what Xavier's move scripts do, and he follows Xavier's movement rules for his hover.",
    "mechanics": "Xavier rushes down opponents with quick attacks, manipulating gravity to make himself float or opponents heavier.",
    "combo": [
      {
        "name": "Electromagnetic Sphere",
        "description": "Throw out a ball of energy, that keeps opponents in place on hit."
      },
      {
        "name": "Shockpulse",
        "description": "Smashing into the ground, send out a pulsing shockwave, leaving opponents shocked and defenseless!"
      },
      {
        "name": "Gravitational Pull",
        "description": "Using all your energy, form a gigantic sphere that increases opponent's gravitational pull and causes the ground to pulsate with energy that shocks opponents."
      }
    ]
  },
