  "text": {
    "lore": "Arc and Phantom, half and half, built from diamonds and a triangle in the mod maker. Five moves are Arc's and five are Phantom's, and every number in between is the average of the two.",
    "mechanics": "Arc's sword attacks and Judgement, with Phantom's shadowflame, teleport and air spin. No template: the moves are this character's own data and its gimmick script.",
    "combo": [
      {
        "name": "Shadowflame Charge",
        "description": "Fire a quick moving shadowflame ball that explodes on contact, or if you press the attack button!"
      },
      {
        "name": "Shadow Trick",
        "description": "Teleport to the opponent, leaving an explosion behind. The direction you hold determines your exact teleporting position!"
      },
      {
        "name": "Judgement",
        "description": "Catch the opponent in front of you, trapping them in a flurry of slashes and send them flying with a final blow!"
      }
    ]
  },
